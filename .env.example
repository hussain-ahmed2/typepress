# Database
DATABASE_URL="postgresql://typepress:typepress_secret@localhost:5433/typepress?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Storage
# STORAGE_DRIVER: "local" (default, filesystem) or "s3" (MinIO/S3-compatible)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="uploads"
STORAGE_PUBLIC_URL="/uploads"

# MinIO / S3-compatible object storage (used when STORAGE_DRIVER="s3")
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="typepress-media"
MINIO_USE_SSL="false"
MINIO_REGION="us-east-1"

# API
API_PORT=8000
API_HOST="0.0.0.0"
SESSION_SECRET="change-me-in-production-32-chars!!"
SESSION_STORE="redis" # redis|memory (defaults: redis in production, memory in dev/test)

# Apps
ADMIN_URL="http://localhost:8001"
RENDERER_URL="http://localhost:8002"
API_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# SMTP (optional — if unset, auth emails are logged safely in dev)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASS="replace-me"
# SMTP_FROM="noreply@example.com"
# SMTP_SECURE="false"
